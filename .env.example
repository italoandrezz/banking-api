# Only for a NEW database. Existing volumes require docs/postgresql-security.md.
# Never overwrite an existing .env; restrict its filesystem permissions.
# Keep secrets in private files; see docs/secrets.md for permissions and adoption.
# Required files: admin_password, app_password, migrator_password, jwt_secret.
# Values are never stored in this file. Prefer an absolute path outside the repository.
SECRETS_DIR=
DB_NAME=banking_db
DB_ADMIN_USERNAME=banking_admin
DB_USERNAME=banking_app
# Only db bootstrap and the one-shot migrate service; never the API runtime.
FLYWAY_USERNAME=banking_migrator
# Use at least 32 random ASCII characters (for example, 32 random bytes in Base64).
# The application uses the supplied text as UTF-8; it does not decode Base64.
# Changing the jwt_secret file requires recreating ALL API containers.
# Old tokens are rejected only after every instance uses the new key.
API_PORT=8080
# Token lifetime in milliseconds: 1..86400000 (maximum 24 hours).
# Reducing this value does not revoke tokens that have already been issued.
JWT_EXPIRATION=86400000

# Nginx: requests/minute; burst is additional immediate requests (minimum 1).
AUTH_LOGIN_RATE=10
AUTH_LOGIN_BURST=5
AUTH_REGISTER_RATE=3
AUTH_REGISTER_BURST=2
# Shared by all IPs and both POST authentication endpoints.
AUTH_TOTAL_RATE=600
AUTH_TOTAL_BURST=30
