worker_processes 2;
pid /tmp/nginx.pid;
# Native Nginx errors can contain peer IPs, request lines and headers.
error_log /dev/null;
events { worker_connections 1024; }
http {
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server_tokens off;
    merge_slashes on;

    map $request_id $generated_id {
        "~^(?<id_a>.{8})(?<id_b>.{4})(?<id_c>.{4})(?<id_d>.{4})(?<id_e>.{12})$" "$id_a-$id_b-$id_c-$id_d-$id_e";
    }
    map $http_x_correlation_id $correlation_id {
        default $generated_id;
        "~^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" $http_x_correlation_id;
    }
    # Match normalized paths. Query strings never participate in the keys.
    map "$request_method:$uri" $auth_endpoint {
        default "";
        ~^POST:/auth/login/?$ login;
        ~^POST:/customers/?$ register;
    }
    map $auth_endpoint $login_key { default ""; login $binary_remote_addr; }
    map $auth_endpoint $register_key { default ""; register $binary_remote_addr; }
    map $auth_endpoint $total_key { default "authentication"; "" ""; }
    map $auth_endpoint $retry_after {
        default ${LOGIN_RETRY_AFTER};
        register ${REGISTER_RETRY_AFTER};
    }
    # No financial route needs encoded path segments or matrix parameters.
    # Reject ambiguous representations instead of relying on two parsers agreeing.
    map $request_uri $ambiguous_path {
        default 0;
        "~^[^?]*[%;]" 1;
        "~^[^?]*\\\\" 1;
    }

    limit_req_zone $login_key zone=login:1m rate=${AUTH_LOGIN_RATE}r/m;
    limit_req_zone $register_key zone=register:1m rate=${AUTH_REGISTER_RATE}r/m;
    limit_req_zone $total_key zone=authentication:1m rate=${AUTH_TOTAL_RATE}r/m;
    log_format safe escape=json '{"timestamp":"$time_iso8601","event":"proxy_request","status":$status,"durationSeconds":$request_time,"limiter":"$limit_req_status","correlationId":"$correlation_id"}';
    access_log /dev/stdout safe;

    upstream banking_api {
        zone banking_api 64k;
        resolver 127.0.0.11 valid=5s ipv6=off;
        server api:8080 resolve;
    }

    server {
        listen 8080 default_server;
        server_name _;
        add_header X-Correlation-ID $correlation_id always;
        error_page 429 = @rate_limited;
        if ($ambiguous_path) { return 400; }

        location / {
            limit_req zone=login burst=${AUTH_LOGIN_BURST} nodelay;
            limit_req zone=register burst=${AUTH_REGISTER_BURST} nodelay;
            limit_req zone=authentication burst=${AUTH_TOTAL_BURST} nodelay;
            limit_req_status 429;
            # URI suffix '/' forwards the same normalized path used by the limiter.
            proxy_pass http://banking_api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Correlation-ID $correlation_id;
            proxy_hide_header X-Correlation-ID;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Forwarded-Prefix "";
            # Never replay a financial request to another replica after a failure.
            proxy_next_upstream off;
        }

        location @rate_limited {
            default_type application/json;
            add_header X-Correlation-ID $correlation_id always;
            add_header Retry-After $retry_after always;
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
            return 429 '{"status":429,"error":"Too Many Requests","message":"Request limit exceeded. Try again later."}';
        }
    }
}
